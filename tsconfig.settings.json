{
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",
		"target": "esnext",
		"jsx": "react-jsx",
		"module": "preserve",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true
	}
}
